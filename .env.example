# Server Port & Host
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Frontend Dev & Proxy
VITE_API_URL=http://localhost:4000

# SQLite Database
DATABASE_PATH=./data/seo_analyzer.db

# Crawler Security & Constraints
CRAWLER_USER_AGENT=SEOAnalyzerBot/1.0 (+https://example.com/bot)
CRAWLER_TIMEOUT_MS=15000
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_SIZE_BYTES=10485760

# Optional External SEO API Keys (Reserved for future integrations)
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# AHREFS_API_KEY=
# SEMRUSH_API_KEY=
