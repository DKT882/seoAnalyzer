# Server Port & Host
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Frontend Dev & Proxy
VITE_API_URL=http://localhost:4000

# SQLite Database
DATABASE_PATH=./data/seo_analyzer.db

# Crawler Security & Constraints
CRAWLER_USER_AGENT=SEOAnalyzerBot/1.0 (+https://example.com/bot)
CRAWLER_TIMEOUT_MS=15000
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_SIZE_BYTES=10485760

# Optional External SEO Data Provider (DataForSEO Integration)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com

# AI SEO Provider (Local LLM via Ollama - Recommended)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_RETRIES=2

# Alternative Cloud / OpenAI / Anthropic Providers (Optional)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# Other Optional Data Sources
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# AHREFS_API_KEY=
# SEMRUSH_API_KEY=


